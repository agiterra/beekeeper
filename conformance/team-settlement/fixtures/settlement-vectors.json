    {
      "name": "approving-disposition-without-an-ask-settles-with-no-acknowledgement",
      "why": "Lane 210's rule. `approve` with `requiredAction: null` asks the assignee for nothing, so the chain is complete without a receipt.",
      "records": [
        {
          "id": "assignment",
          "type": "assignment",
          "author": "founder"
        },
        {
          "id": "report",
          "type": "report",
          "author": "assignee",
          "assignmentRef": "assignment"
        },
        {
          "id": "disposition",
          "type": "disposition",
          "author": "founder",
          "assignmentRef": "assignment",
          "reportRef": "report",
          "decision": "approve",
          "findings": [],
          "requiredAction": null,
          "settlementFact": "approving_disposition_without_ask"
        }
      ],
      "expected": {
        "assignments": [
          {
            "assignment": "assignment",
            "settled": true,
            "settledBy": "approving_disposition_without_ask",
            "governedReport": "report",
            "disposition": "disposition",
            "acknowledgement": null,
            "awaiting": null
          }
        ],
        "terminal": null,
        "pendingCompletion": null
      }
    },
