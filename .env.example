# =============================================================================
# Beekeeper Backend — Local Development Environment
# =============================================================================
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# All defaults here work with `docker compose up` out of the box.
#
# Service ports (defaults):
#   Postgres    → localhost:5432
#   Redis       → localhost:6379
#   Typesense   → localhost:8108
#   Adminer     → localhost:8082  (DB browser UI)
#
# Note: If port 8082 conflicts, change the adminer port in docker-compose.yml
#
# Variable names: BEEKEEPER_* replaced BUZZ_* in the rename. Every binary still
# reads a BUZZ_* name whose BEEKEEPER_* twin is unset (and prints one startup
# line naming it), so an older .env keeps working; `just env-migrate` rewrites
# one in place and keeps .env.bak. None of these names is interpolated by the
# root docker-compose.yml. deploy/compose/.env.example is different: some of
# its BUZZ_* names are read by Compose itself and stay as they are.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Postgres 17)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://buzz:buzz_dev@localhost:5432/buzz
# Optional read-replica URL; unset/blank keeps all reads on the writer.
# READ_DATABASE_URL=postgres://buzz:buzz_dev@localhost:5433/buzz
PGHOST=localhost
PGPORT=5432
PGUSER=buzz
PGPASSWORD=buzz_dev
PGDATABASE=buzz

# -----------------------------------------------------------------------------
# Redis 7
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Max connections in the relay's shared Redis pool (default 16).
# BEEKEEPER_REDIS_POOL_SIZE=16

# Max connections in each of the relay's Postgres pools — writer and, when
# READ_DATABASE_URL is set, reader (default 50).
# BEEKEEPER_DB_POOL_SIZE=50

# -----------------------------------------------------------------------------
# Typesense (search)
# -----------------------------------------------------------------------------
TYPESENSE_API_KEY=buzz_dev_key
TYPESENSE_URL=http://localhost:8108

# -----------------------------------------------------------------------------
# Relay (WebSocket server)
# -----------------------------------------------------------------------------
# Bind address for the relay (host:port)
BEEKEEPER_BIND_ADDR=0.0.0.0:3000
# Public WebSocket URL — used in NIP-42 auth challenges
RELAY_URL=ws://localhost:3000
# Stable relay signing key (required). `just bootstrap` generates a random key in
# the gitignored .env file. Preserve that value across restarts and backups.
# BEEKEEPER_RELAY_PRIVATE_KEY=<32-byte hex private key>
# Optional: path to the web UI dist directory. When set, the relay serves
# the web frontend at / for browser requests. Leave unset for local dev
# (use `just web` for Vite HMR instead).
# BEEKEEPER_WEB_DIR=./web/dist

# Admission limits. Defaults shown below; each value must be a positive
# integer. The *_PER_MIN quotas are shared per (community, pubkey) in Redis —
# every socket a key holds draws on one pool. The WS *_PER_SEC rates are
# per connection, kept in relay memory over a 5 s burst window (10/s = a burst
# of 50), so a phone and a desktop on one key never spend each other's
# budget; REQ/COUNT never touch Redis. Ephemeral EVENTs (kinds 20000–29999)
# get their own per-connection burst but stay counted against the shared
# HUMAN_MESSAGES_PER_MIN quota. The relay advertises the enforced figures
# under NIP-11 `limitation.rate_limits`.
# BEEKEEPER_RATE_LIMIT_HUMAN_MESSAGES_PER_MIN=60
# BEEKEEPER_RATE_LIMIT_HUMAN_API_CALLS_PER_MIN=300
# BEEKEEPER_RATE_LIMIT_HUMAN_WS_EVENTS_PER_SEC=10
# BEEKEEPER_RATE_LIMIT_WS_READS_PER_SEC=30
# BEEKEEPER_RATE_LIMIT_WS_EPHEMERAL_PER_SEC=100
# BEEKEEPER_MAX_WS_CONNECTIONS_PER_PUBKEY=8
# BEEKEEPER_RATE_LIMIT_AGENT_STANDARD_MESSAGES_PER_MIN=120
# BEEKEEPER_RATE_LIMIT_AGENT_STANDARD_API_CALLS_PER_MIN=600
# BEEKEEPER_RATE_LIMIT_AGENT_ELEVATED_MESSAGES_PER_MIN=300
# BEEKEEPER_RATE_LIMIT_AGENT_PLATFORM_MESSAGES_PER_MIN=600

# -----------------------------------------------------------------------------
# Git (NIP-34 bare repositories)
# -----------------------------------------------------------------------------
# Root directory for ephemeral Git workspaces and the disposable pack cache.
# Default: ./repos (relative to CWD).
# BEEKEEPER_GIT_REPO_PATH=./repos
# BEEKEEPER_GIT_MAX_PACK_BYTES=524288000
# BEEKEEPER_GIT_MAX_REPO_BYTES=1048576000
# Process-local immutable pack/index cache. Zero disables retention.
# BEEKEEPER_GIT_PACK_CACHE_PATH=./repos/.pack-cache
# BEEKEEPER_GIT_PACK_CACHE_MAX_BYTES=5368709120
# BEEKEEPER_GIT_PACK_CACHE_MAX_CONCURRENT_POPULATIONS=2
# NIP-98 freshness window for the git transport, in seconds. Default: 600.
# Wider than the ±60s the rest of the HTTP surface uses, because git mints one
# token at `GET info/refs` and reuses it for the `POST` that follows pre-push
# hooks and pack building — under 60s a slow push fails every time, not
# sometimes. This is also how long an observed token stays replayable, and the
# git transport does not bind the HTTP method, so lower it if you can afford to.
# Values below 60 are clamped up to 60.
# BEEKEEPER_GIT_NIP98_TOLERANCE_SECS=600

# -----------------------------------------------------------------------------
# S3-Compatible Object Storage (media + Git/CAS)
# -----------------------------------------------------------------------------
# The local MinIO container is reachable from host processes at localhost:9000.
# Path style keeps the bucket in the URL path and is required by this local DNS
# setup. Use `virtual` only when the provider requires bucket-as-subdomain URLs.
BEEKEEPER_S3_ENDPOINT=http://localhost:9000
BEEKEEPER_S3_ACCESS_KEY=buzz_dev
BEEKEEPER_S3_SECRET_KEY=buzz_dev_secret
BEEKEEPER_S3_BUCKET=buzz-media
BEEKEEPER_S3_REGION=us-east-1
BEEKEEPER_S3_ADDRESSING_STYLE=path

# -----------------------------------------------------------------------------
# Media Upload Admission
# -----------------------------------------------------------------------------
# Bound image/video parser and storage work admitted by one relay process.
# BEEKEEPER_MEDIA_MAX_CONCURRENT_UPLOADS=8
# BEEKEEPER_MEDIA_MAX_CONCURRENT_UPLOADS_PER_PUBKEY=2
# BEEKEEPER_MEDIA_UPLOADS_PER_MINUTE=30
# GET/HEAD /media/* always require Blossom t=get auth and relay membership.
# BEEKEEPER_REQUIRE_MEDIA_GET_AUTH and BEEKEEPER_REQUIRE_MEDIA_READ_AUTH are no longer
# read; setting either (including to false) changes nothing and the relay warns
# about it at startup.

# -----------------------------------------------------------------------------
# Ephemeral Channels (TTL testing)
# -----------------------------------------------------------------------------
# Override the TTL for all ephemeral channels (in seconds). When set, any
# channel created with a TTL tag will use this value instead of the
# client-provided one. Unset to use the client-provided TTL.
# BEEKEEPER_EPHEMERAL_TTL_OVERRIDE=60

# How often the reaper checks for expired ephemeral channels (default: 60s).
# BEEKEEPER_REAPER_INTERVAL_SECS=5

# -----------------------------------------------------------------------------
# Logging / Tracing
# -----------------------------------------------------------------------------
RUST_LOG=beekeeper_relay=debug,beekeeper_datastore=info,beekeeper_db=debug,beekeeper_auth=debug,beekeeper_pubsub=debug,tower_http=debug
# Optional OpenTelemetry-only target filter. This is deliberately independent
# from RUST_LOG so log verbosity changes cannot break trace parentage.
# BEEKEEPER_OTEL_FILTER=beekeeper_relay=info,beekeeper_datastore=info

# OTLP tracing endpoint (optional — leave unset to disable)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# -----------------------------------------------------------------------------
# ACP (Agent Communication Protocol — beekeeper-acp harness)
# -----------------------------------------------------------------------------
# The ACP harness bridges Beekeeper events to AI agents. Each env var below maps
# to a CLI flag of the same name (lowercase, hyphens → underscores). All values
# are optional unless noted; defaults are shown in comments.
#
# Quick start:
#   BEEKEEPER_PRIVATE_KEY=<hex>  BEEKEEPER_RELAY_URL=ws://localhost:3000  beekeeper-acp

# ── Identity & auth ──────────────────────────────────────────────────────────
# Nostr private key (hex or bech32). REQUIRED — identifies the agent on the relay.
# BEEKEEPER_PRIVATE_KEY=<32-byte hex or nsec1… private key>

# Relay WebSocket URL the harness connects to.
# Note: the relay itself uses RELAY_URL (above); this is the ACP harness's
# connection target — they happen to point at the same place in local dev.
# BEEKEEPER_RELAY_URL=ws://localhost:3000

# ── Agent subprocess ─────────────────────────────────────────────────────────
# Binary to spawn as the AI agent (e.g. "goose", "codex-acp", "claude-code").
# BEEKEEPER_ACP_AGENT_COMMAND=goose

# Comma-separated arguments passed to the agent binary.
# Goose default: "acp". Codex/Claude default: "" (empty).
# BEEKEEPER_ACP_AGENT_ARGS=acp

# Binary for an optional MCP server sidecar (e.g. beekeeper-dev-mcp for beekeeper-agent).
# BEEKEEPER_ACP_MCP_COMMAND=

# Number of parallel agent subprocesses (1–32).
# BEEKEEPER_ACP_AGENTS=1

# Desired LLM model ID. Applied to every new ACP session.
# Use `beekeeper-acp models` to discover available model IDs.
# BEEKEEPER_ACP_MODEL=

# ── Timeouts & sessions ──────────────────────────────────────────────────────
# Max seconds per agent turn before timeout (default 320 = ~5 min).
# BEEKEEPER_ACP_TURN_TIMEOUT=320

# Max turns per session before proactive rotation. 0 = disabled (rotate only
# on MaxTokens / MaxTurnRequests). Recommended: 50 for long-running agents.
# BEEKEEPER_ACP_MAX_TURNS_PER_SESSION=0

# ── Prompts ──────────────────────────────────────────────────────────────────
# System prompt injected into every agent session (inline text).
# BEEKEEPER_ACP_SYSTEM_PROMPT=

# Path to a file containing the system prompt (mutually exclusive with above).
# BEEKEEPER_ACP_SYSTEM_PROMPT_FILE=

# Message sent to the agent immediately after session creation.
# BEEKEEPER_ACP_INITIAL_MESSAGE=

# ── Heartbeat ────────────────────────────────────────────────────────────────
# Seconds between heartbeat prompts. 0 = disabled. Must be 0 or ≥10.
# Recommended: 60 for long-running agents to prevent idle session timeouts.
# BEEKEEPER_ACP_HEARTBEAT_INTERVAL=0

# Heartbeat prompt text (inline). Mutually exclusive with file variant.
# BEEKEEPER_ACP_HEARTBEAT_PROMPT=

# Path to a file containing the heartbeat prompt.
# BEEKEEPER_ACP_HEARTBEAT_PROMPT_FILE=

# ── Desktop development ──────────────────────────────────────────────────────
# DEV-only: replay first-run onboarding and the Welcome Team kickoff on each
# app launch while keeping the current identity and relay data.
# VITE_BUZZ_FORCE_FRESH_ONBOARDING=true

# ── Subscription & filtering ─────────────────────────────────────────────────
# Subscribe mode: "mentions" (default), "all", or "config" (rule-based).
# BEEKEEPER_ACP_SUBSCRIBE=mentions

# Comma-separated event kind numbers to subscribe to (overrides mode defaults).
# BEEKEEPER_ACP_KINDS=

# Comma-separated channel UUIDs to limit subscription scope.
# BEEKEEPER_ACP_CHANNELS=

# Set to true to disable the @-mention filter in mentions mode.
# BEEKEEPER_ACP_NO_MENTION_FILTER=false

# Path to TOML config file for rule-based subscriptions (config mode).
# BEEKEEPER_ACP_CONFIG=./beekeeper-acp.toml

# ── Dedup & self-ignore ──────────────────────────────────────────────────────
# How to handle duplicate events: "queue" (default) or "drop".
# BEEKEEPER_ACP_DEDUP=queue

# Set to true to process the agent's own messages (default: ignore self).
# BEEKEEPER_ACP_NO_IGNORE_SELF=false

# ── Session scoping ──────────────────────────────────────────────────────────
# How ACP provider sessions are scoped in channels: "channel" (default) or
# "thread". "channel" keeps one provider session per channel (legacy). "thread"
# gives each canonical channel thread its own isolated provider session; direct
# messages stay conversation-scoped either way. Ships as "channel" so thread
# scoping can be canaried and rolled back without code changes.
# BEEKEEPER_ACP_SESSION_POLICY=channel

# ── Context ──────────────────────────────────────────────────────────────────
# Max context messages fetched for thread replies and DMs (0–100). 0 = disabled.
# BEEKEEPER_ACP_CONTEXT_MESSAGE_LIMIT=12

# ── Presence & typing ────────────────────────────────────────────────────────
# Set to true to disable automatic online/offline presence status.
# BEEKEEPER_ACP_NO_PRESENCE=false

# Set to true to disable typing indicators while the agent is processing.
# BEEKEEPER_ACP_NO_TYPING=false

# ── Advanced tuning ──────────────────────────────────────────────────────────
# Event channel buffer capacity (WebSocket → harness). Increase for
# high-throughput agents. Minimum 1.
# BEEKEEPER_ACP_EVENT_BUFFER=256

# ── Legacy aliases ───────────────────────────────────────────────────────────
# These are accepted for backward compatibility but the canonical names above
# are preferred:
#   BEEKEEPER_ACP_PRIVATE_KEY  → BEEKEEPER_PRIVATE_KEY

# Optional relay join policy. Markdown is served by the relay so every join
# surface can present the same documents. Each document and the independent age
# attestation are optional; configuring any one enables policy acceptance.
# BEEKEEPER_TERMS_OF_SERVICE_MARKDOWN="# Terms of Service\n\nFull terms here."
# BEEKEEPER_PRIVACY_POLICY_MARKDOWN="# Privacy Policy\n\nFull policy here."
# BEEKEEPER_AGE_ATTESTATION_REQUIRED=true
