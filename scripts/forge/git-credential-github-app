#!/usr/bin/env bash
# Git credential helper: answer for https://github.com with a GitHub App
# installation token, so the mirror's pushes reach GitHub — and Woodpecker —
# as `<app-slug>[bot]` instead of as whoever added a deploy key.
#
# Installed at /usr/local/bin/git-credential-github-app on the forge incus
# container (agincus) by scripts/forge/setup-hive-mirror.sh. Configuration is
# git config, read from the invoking user's config (the `git` user's global):
#
#   githubApp.appId           the App ID from the app's settings page
#   githubApp.installationId  the installation on the org that owns the repo
#   githubApp.keyFile         the app's private key (.pem), 0600, owned by git
#
# Every `get` mints a fresh token: sign a ten-minute JWT with the app key,
# exchange it for an installation token (valid one hour). A push takes
# seconds, so nothing is cached. `store` and `erase` are no-ops — the token
# is never written anywhere. Needs only bash, openssl and curl.
set -euo pipefail

[ "${1:-}" = "get" ] || exit 0

host=""
while IFS= read -r line && [ -n "$line" ]; do
    case "$line" in
        host=*) host="${line#host=}" ;;
    esac
done
# Stay silent for any other host: git falls through to the next helper.
[ "$host" = "github.com" ] || exit 0

conf() {
    git config --get "githubApp.$1" || {
        echo "git-credential-github-app: githubApp.$1 is not set" >&2
        exit 1
    }
}
app_id=$(conf appId)
installation_id=$(conf installationId)
key_file=$(conf keyFile)

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

now=$(date +%s)
# iat backdated a minute for clock skew; GitHub caps exp at ten minutes.
header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' \
    $((now - 60)) $((now + 540)) "$app_id" | b64url)
signature=$(printf '%s.%s' "$header" "$payload" \
    | openssl dgst -sha256 -sign "$key_file" -binary | b64url)

response=$(curl -fsS -X POST \
    -H "Authorization: Bearer $header.$payload.$signature" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/app/installations/$installation_id/access_tokens")

token=$(printf '%s' "$response" \
    | sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
if [ -z "$token" ]; then
    echo "git-credential-github-app: no token in GitHub's response" >&2
    exit 1
fi

printf 'username=x-access-token\npassword=%s\n' "$token"
