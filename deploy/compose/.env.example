# Beekeeper production Docker Compose environment.
# Copy to .env and replace every CHANGE_ME value before running.
# The bootstrap script should generate this file for normal users.
#
# Two spellings, on purpose:
# - BEEKEEPER_* names are read by the relay itself (through env_file). They
#   were BUZZ_* before the rename; the relay still reads a BUZZ_* name when its
#   BEEKEEPER_* twin is unset, so an older .env keeps working.
# - BUZZ_* names below are interpolated by Docker Compose (compose.yml,
#   compose.caddy.yml, run.sh) and keep their old names for now, because live
#   deployments' .env files are hand-managed. Do not rename them here alone.

# Image published by the public image pipeline. Use `:main` for pre-release testing. Pin `:sha-<7>` or a semver release tag for production.
BUZZ_IMAGE=beekeeper-relay:latest

# Public host name. Used by compose.caddy.yml and URL-derived settings below.
BUZZ_DOMAIN=buzz.example.com
RELAY_URL=wss://buzz.example.com
BEEKEEPER_MEDIA_BASE_URL=https://buzz.example.com/media
BEEKEEPER_MEDIA_SERVER_DOMAIN=buzz.example.com
BEEKEEPER_CORS_ORIGINS=https://buzz.example.com

# Production defaults. Closed relay mode requires RELAY_OWNER_PUBKEY and a stable relay key.
BEEKEEPER_REQUIRE_AUTH_TOKEN=true
BEEKEEPER_REQUIRE_RELAY_MEMBERSHIP=true
BEEKEEPER_ALLOW_NIP_OA_AUTH=true
# Interpolated by compose.yml into the relay's BEEKEEPER_AUTO_MIGRATE and
# BEEKEEPER_GIT_CONFORMANCE_PROBE.
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=beekeeper_relay=info,beekeeper_db=info,beekeeper_auth=info,beekeeper_pubsub=info,tower_http=info

# Owner identity. Set to a 64-character hex Nostr pubkey.
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Stable secrets. Generate once, keep in .env, and back up securely.
BEEKEEPER_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
BEEKEEPER_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
# Interpolated by compose.yml for both RustFS and the relay's BEEKEEPER_S3_*.
BUZZ_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
BUZZ_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
BUZZ_S3_BUCKET=buzz-media
# Bundled RustFS uses path-style URLs; deploy/compose/compose.yml pins this.
BEEKEEPER_S3_ADDRESSING_STYLE=path

# Optional host ports. Base compose publishes the relay directly on BUZZ_HTTP_PORT.
BUZZ_HTTP_PORT=3000

# Caddy host ports. Only used with compose.caddy.yml.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Dev override ports. Only used with compose.dev.yml.
POSTGRES_PORT=5432
REDIS_PORT=6379
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
ADMINER_PORT=8082
PROMETHEUS_PORT=9090
