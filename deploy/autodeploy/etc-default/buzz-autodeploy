# /etc/default/buzz-autodeploy — vanilla Buzz, lightyear.agiterra.org
#
# Read by buzz-autodeploy.service via EnvironmentFile=. systemd parses this
# itself, not a shell: no `export`, no command substitution, no variable
# expansion. Plain KEY=value only.
#
# REPO_ID is the load-bearing line. Woodpecker serves both repos and both use
# branch `main`, so a query that is not pinned to a repo returns whichever
# pushed most recently — which would deploy Beekeeper onto this vanilla relay,
# and it would come up healthy. Cross-check against the other config in this
# directory: the two REPO_IDs must differ.
AUTODEPLOY_NAME=buzz
REPO_ID=1
MIRROR=/srv/git/buzz.git
INSTANCE=buzz
BASE=/opt/buzz
IMAGE_NAME=buzz-relay
