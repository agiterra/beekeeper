[Unit]
Description=Deploy latest CI-green agiterra/buzz main build to the buzz instance
Documentation=file:/usr/local/sbin/autodeploy

[Service]
Type=oneshot
User=debian
# No `-` prefix on purpose: a missing config file must fail the unit rather
# than let the deployer start unconfigured and pick its own target.
EnvironmentFile=/etc/default/buzz-autodeploy
ExecStart=/usr/local/sbin/autodeploy
# a cold relay image build takes ~15 min
TimeoutStartSec=3600
